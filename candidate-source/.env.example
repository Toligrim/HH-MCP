# hh-mcp configuration reference.
# The server does NOT auto-load .env / .env.local — set these in your MCP client
# config (Claude Desktop / Cursor / etc.) or the process environment.
# All variables are optional; public hh.ru endpoints work without them.

# OAuth 2.0 Bearer token for hh.ru. Required for resume / ATS / employer-scoped
# tools. Resume search also needs an employer account with a paid resume-database
# subscription. Get a token at https://dev.hh.ru/admin
# HH_ACCESS_TOKEN=

# hh.ru REQUIRES an HH-User-Agent header and recommends a contact address.
# Override the default with your own app name + contact email.
# Example: my-job-bot/1.0 (me@example.com)
# HH_USER_AGENT=

# Cap for list_applications(with_updates_only) page walks (default: 10).
# Prevents a huge collection from turning one tool call into dozens of GETs.
# HH_MAX_SCAN_PAGES=10

# --- Resume-view safety (2.2.4+) ---
# Gated budget for unscoped /resumes/{id} and batch tools (defaults are safe).
# HH_RESUME_MAX_CONCURRENCY=1
# HH_RESUME_MIN_INTERVAL_MS=1500
# Sliding window (3.0.0+): max gated starts per window; 0 disables.
# HH_RESUME_MAX_PER_WINDOW=20
# HH_RESUME_WINDOW_MS=60000
# Shared lock across two MCP instances on one host (default: tmpdir file).
# HH_BUDGET_FILE=
# Set to "off" to disable cross-process sharing.
# HH_BUDGET_FILE=off

# Captcha breaker
# HH_CAPTCHA_COOLDOWN_MS=60000
# HH_CAPTCHA_COOLDOWN_MAX_MS=600000
# HH_CAPTCHA_RETRY_S=45,120,300
# Recovery after a captcha: interval x2 / window /2 for 10 reads, within this span.
# HH_CAPTCHA_RECOVERY_MS=600000
# HH_CAPTCHA_RECOVERY_STEP_MS=5000

# Resume disk cache (default: tmpdir/hh-mcp-cache, TTL 24h). HH_CACHE_TTL_MS=0 disables.
# HH_CACHE_DIR=
# HH_CACHE_TTL_MS=86400000

# Optional post-mortem artefacts
# HH_LEDGER_FILE=
# HH_LOG_DIR=
# HH_EXPORT_DIR=
# Label this process in ledger /health / hh_usage_report (e.g. 3011 or Addwise).
# HH_INSTANCE=

# Block accidental paid get_resume without topic_id (opt-in). Use allow_unscoped:true to override.
# HH_REQUIRE_TOPIC=1

# Soft quota line on resume reads (informational only — not the captcha gate)
# HH_QUOTA_CHECK=off
# Remember the working quota endpoint for this long (default 1h).
# HH_QUOTA_PATH_TTL_MS=3600000
# hh_usage_report refreshes quota if older than this (default 30 min).
# HH_QUOTA_STALE_MS=1800000
# Log quota.path.probe failures (default off).
# HH_DEBUG=1

# API base URL override for tests against a local mock server.
# HH_API_BASE_URL=https://api.hh.ru

# Trim tool surface (names and/or groups, comma-separated). Fail-loud on unknown.
# Example triage profile (~15 tools):
# HH_TOOLS=negotiations,resumes,batch,validate_token,diagnostics
# HH_TOOLS_EXCLUDE=
# CLI: --tools negotiations,resumes,batch --tools-exclude salary

# --- HTTP mode (only when started with --http) ---
# Example: HTTP_PORT=8080 npx @andrey-tepaykin/hh-mcp --http

# Port for HTTP mode (default: 3000). PORT is also honored.
# HTTP_PORT=3000

# Interface to bind in HTTP mode (default: 127.0.0.1). Set to 0.0.0.0 to expose.
# HOST=127.0.0.1

# DNS-rebinding protection allow-lists for HTTP mode. Comma-separated.
# Defaults to 127.0.0.1:<port>,localhost:<port>. If you bind to a public host,
# add it here or legitimate requests get a 403.
# HH_ALLOWED_HOSTS=
# HH_ALLOWED_ORIGINS=
